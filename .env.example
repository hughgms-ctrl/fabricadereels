# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# YouTube Data API v3 (grátis: 10 mil unidades por dia).
# Google Cloud Console → APIs e serviços → Ativar "YouTube Data API v3" → Credenciais → Chave de API.
YOUTUBE_API_KEY=

# Instagram (Business Discovery da Graph API). Grátis.
# ID do SEU Instagram profissional (o que faz a consulta) e o token de acesso dele.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Opcional: cookies do Instagram (formato Netscape) para o yt-dlp baixar o vídeo quando a API
# não entrega o media_url (reel com música licenciada ou download desligado pelo dono).
# Use uma conta secundária, nunca a principal.
IG_COOKIES=

# Comando do Claude Code no Termux (já logado com a sua conta).
CLAUDE_BIN=claude

# Transcrição de reels do Instagram: "whisper" (whisper.cpp no celular) ou "nenhuma".
# YouTube usa a legenda automática primeiro, sem gastar nada.
TRANSCRICAO_REELS=whisper
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODELO=modelos/ggml-base.bin
